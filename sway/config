# ~/.config/sway/config
# Sway configuration for ThinkPad X240
# ==========================================

### Variables ###
set $mod Mod4

# Default apps
set $term alacritty
set $menu rofi -show drun
set $browser firefox
set $filemanager nautilus

# Lock command
set $lock 'swaylock -f'


### Output (display) configuration ###
# The X240 internal display is eDP-1 at 1366x768
output eDP-1 {
    resolution 1366x768
    position 0,0
    scale 1
    background ~/.config/sway/wallpaper.jpg fill
}
# If you don't have a wallpaper yet, comment the "background" line above,
# or run: swaybg -i /usr/share/backgrounds/your-image.jpg -m fill


### Input configuration ###
# Touchpad - Synaptics on X240
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt enabled              # disable while typing
    middle_emulation enabled
    scroll_method two_finger
    accel_profile adaptive
    pointer_accel 0.2
    drag_lock disabled
    scroll_factor 0.5
}

# Trackpoint - classic ThinkPad red nub
input "type:pointer" {
    accel_profile flat
    pointer_accel 0
}

# Keyboard
input "type:keyboard" {
    xkb_layout us         
    repeat_delay 300
    repeat_rate 40
}


### Appearance ###
# Gaps (spacing between windows)
gaps inner 6
gaps outer 2

# Borders
default_border pixel 4
default_floating_border pixel 4
titlebar_padding 4
font pango:JetBrains Mono 10


# Catppuccin color scheme — uniform vivid border on focused window
# class                 border  bg      text    indicator child_border
client.focused          #da7333 #1e1e2e #cdd6f4 #8c3e0f   #da7333
client.focused_inactive #45475a #1e1e2e #585b70 #45475a   #45475a
client.unfocused        #313244 #1e1e2e #6c7086 #313244   #313244
client.urgent           #f38ba8 #1e1e2e #cdd6f4 #f38ba8   #f38ba8


### Status bar ###
# Started before the tray-icon autostarts below: nm-applet/blueman-applet
# register with waybar's StatusNotifierWatcher on launch and silently fail
# (process exits) if waybar isn't already running to host it.
bar {
    swaybar_command waybar
}


### Autostart ###
exec ~/.config/sway/scripts/workspace_compact.py
exec /usr/libexec/polkit-gnome-authentication-agent-1
exec mako
exec nm-applet --indicator
exec blueman-applet
exec_always pkill wlsunset; sleep 1 && wlsunset -t 3999 -T 4000
exec wl-paste --type text --watch cliphist store
exec swayidle -w \
    timeout 300 $lock \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep $lock


### Key bindings ###

# Launchers
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+b exec $browser
bindsym $mod+f exec $filemanager
bindsym $mod+shift+q kill
bindsym $mod+shift+c reload
bindsym $mod+shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym $mod+shift+l exec $lock
bindsym $mod+n exec ~/.config/sway/scripts/toggle-nightlight.sh
bindsym $mod+c exec ~/.config/waybar/scripts/idle_inhibitor.sh toggle
bindsym $mod+v exec 'cliphist list | rofi -dmenu -p clipboard | cliphist decode | wl-copy'

# Alt+Tab — classic window cycling (Mod1 = Alt)
bindsym Mod1+Tab focus next sibling
bindsym Mod1+Shift+Tab focus prev sibling

# Focus movement

# Move windows (arrow keys only — hjkl freed up for focus)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+Left workspace prev
bindsym $mod+Right workspace next
# Scroll while holding $mod (anywhere over a window) — same as scrolling
# over the workspace numbers in waybar
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next
bindsym $mod+ctrl+Up exec ~/.config/sway/scripts/reorder-workspace.py up
bindsym $mod+ctrl+Down exec ~/.config/sway/scripts/reorder-workspace.py down
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move window to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout

# Split direction — controls where the next window opens
# Mod1 = Alt
bindsym $mod+Mod1+Right splith
bindsym $mod+Mod1+Down  splitv

bindsym $mod+s exec swaymsg bar mode toggle  # TEMP: was `layout stacking`; reverted until the stuck-stacking bug is fixed
bindsym $mod+w layout tabbed
bindsym $mod+Shift+s exec ~/.config/sway/scripts/reset-layout.sh
bindsym $mod+z layout toggle split
bindsym $mod+Shift+f exec pkill -SIGUSR1 waybar
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resize mode
mode "resize" {
    bindsym Left resize shrink width 30px
    bindsym Down resize grow height 30px
    bindsym Up resize shrink height 30px
    bindsym Right resize grow width 30px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Screenshots
bindsym Print exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot copied"
# Shift+Print save-to-file binding removed: neither Shift+Print nor Sys_Req
# fires reliably on this keyboard. See CLAUDE.md "Known gotcha: screenshot
# save-to-file binding" before re-adding.

# Media keys
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym $mod+p exec playerctl play-pause

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec ~/.config/sway/scripts/brightness-down.sh

# Mouse drag/resize
floating_modifier $mod normal
bindsym --whole-window $mod+button2 floating toggle

# Lid close → lock and sleep
bindswitch --reload --locked lid:on exec $lock


### Power management ###
# Reduce power usage
exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
    gsettings set org.gnome.desktop.interface text-scaling-factor 1.1
}

bindsym $mod+shift+t exec ~/.config/sway/scripts/toggle-theme.sh


### Window rules ###
for_window [app_id="pavucontrol"] floating enable, resize set 800 600
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable

# Assign apps to workspaces (optional examples)
#assign [app_id="firefox"] workspace 2
#assign [class="discord"] workspace 5


### Load extra config files ###
include /etc/sway/config.d/*
include ~/.config/sway/config.d/*
